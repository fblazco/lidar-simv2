    "checkpoint_every": 5,
    "map_files": []
  },
  "fitness": {
    "progress": 100.0,
    "goal": 500.0,
    "time_bonus": 100.0,
    "collision": 20.0,
    "stall": 30.0,
    "deviation": 30.0,
    "deviation_scale": 2.0,
    "smoothness": 10.0
  },
  "generator": {
    "navigation_mode": "route",
    "control_points": [2, 4],
    "static_obstacles": [3, 8],
    "dynamic_obstacles": [1, 3],
    "speed_range": [0.8, 2.5],
    "pause_range": [0.3, 1.5],
    "on_route_fraction": 0.4
  },
  "genetic": {
    "elitism": 2,
    "tournament_size": 3,
    "init_scale": 0.5,
    "crossover": {"type": "uniform", "rate": 0.8},
    "mutation": {"rate": 0.1, "sigma": 0.3, "sigma_decay": 1.0}
  }
