{
  "window": {"width": 1280, "height": 800, "fps": 60},
  "map": {"cols": 32, "rows": 20, "cell_size": 1.0},
  "simulation": {"dt": 0.05, "max_time": 40.0, "goal_radius": 0.6, "lookahead": 2.0},
  "vehicle": {
    "radius": 0.35,
    "wheelbase": 0.7,
    "max_speed": 4.0,
    "max_reverse_speed": 0.0,
    "max_acceleration": 5.0,
    "max_brake": 8.0,
    "max_steering_angle_deg": 35.0,
    "drag": 0.4
  },
  "lidar": {"num_rays": 72, "fov_deg": 360, "max_range": 8.0},
  "observation": {"use_previous_lidar": true, "distance_scale": 10.0, "deviation_scale": 2.0},
  "policy": {"hidden_layers": [16]},
  "training": {
    "strategy": "genetic",
    "population_size": 50,
    "visible_agents": 4,
    "seed": 2024,
    "scenarios_per_candidate": 3,
    "validation_scenarios": 5,
    "resample_scenarios_every": 0,
